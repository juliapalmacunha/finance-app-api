{
    "swagger": "2.0",
    "info": {
        "title": "Finance App API",
        "description": "API for managing financial transactions",
        "version": "1.0.0"
    },
    "securityDefinitions": {
        "Bearer": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header",
            "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\""
        }
    },
    "security": [
        {
            "Bearer": []
        }
    ],
    "paths": {
        "/api/users": {
            "post": {
                "summary": "Create a new user",
                "tags": ["User"],
                "parameters": [
                    {
                        "name": "user",
                        "required": true,
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/CreateUserParams"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User created successfully",
                        "schema": {
                            "$ref": "#/definitions/UserWithTokens"
                        }
                    },
                    "400": {
                        "description": "Invalid params",
                        "schema": {
                            "$ref": "#/definitions/InvalidParamsErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                }
            },
            "get": {
                "summary": "Get authenticated user ",
                "tags": ["User"],
                "responses": {
                    "200": {
                        "description": "User found successfully",
                        "schema": {
                            "$ref": "#/definitions/CreateUserParams"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            },
            "delete": {
                "summary": "Delete authenticated user",
                "tags": ["User"],
                "responses": {
                    "200": {
                        "description": "User deleted successfully",
                        "schema": {
                            "$ref": "#/definitions/User"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            },
            "patch": {
                "summary": "Update authenticated user",
                "tags": ["User"],
                "responses": {
                    "200": {
                        "description": "User updated successfully",
                        "schema": {
                            "$ref": "#/definitions/User"
                        }
                    },
                    "404": {
                        "description": "Invalid params",
                        "schema": {
                            "$ref": "#/definitions/InvalidParamsErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/users/login":{
            "post": {
                "summary": "Login user created",
                "tags": ["User"],
                "parameters": [
                    {
                        "name": "user",
                        "required": true,
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/LoginUserParams"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User logged in successfully",
                        "schema": {
                            "$ref": "#/definitions/UserWithTokens"
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "schema": {
                            "$ref": "#/definitions/UnauthorizedErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                }
            }
            
        },
        "/api/users/refresh-token":{
            "post": {
                "summary": "Refresh user token",
                "tags": ["User"],
                "parameters": [
                    {
                        "name": "refreshToken",
                        "required": true,
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/RefreshTokensParams"
                        }
                    }
                ],
               
                "responses": {
                    "201": {
                        "description": "Tokens generated successfully",
                        "schema": {
                            "$ref": "#/definitions/Tokens"
                        }
                    },
                    "401": {
                        "description": "Invalid Token",
                        "schema": {
                            "$ref": "#/definitions/UnauthorizedErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                }
            }
            
        },

        "/api/users/balance": {
            "get": {
                "summary": "Get authenticator user balance",
                "tags": ["User"],

                "responses": {
                    "200": {
                        "description": "User balance found successfully",
                        "schema": {
                            "$ref": "#/definitions/UserBalanceResponse"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/transactions": {
            "get": {
                "summary": "Get authenticator user transactions",
                "tags": ["Transaction"],
                "parameters":[
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "description": "Start date for the transactions query (format: YYYY-MM-DD)",
                        "schema": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2026-01-01"
                        }
                    },
                     {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "description": "End date for the transactions query (format: YYYY-MM-DD)",
                        "schema": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2026-01-01"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transactions found successfully",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Transaction"
                            }
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            },
            "post": {
                "summary": "Create a new transaction for a authenticator user",
                "tags": ["Transaction"],
                "responses": {
                    "201": {
                        "description": "Transaction created successfully",
                        "schema": {
                            "$ref": "#/definitions/Transaction"
                        }
                    },
                    "400": {
                        "description": "Invalid params",
                        "schema": {
                            "$ref": "#/definitions/InvalidParamsErrorResponse"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/transactions/{transactionId}": {
            "patch": {
                "summary": "Update a transaction by ID",
                "tags": ["Transaction"],
                "parameters": [
                    {
                        "name": "transactionId",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "ID of the transaction to update"
                    },
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UpdateTransactionParams"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transaction updated successfully",
                        "schema": {
                            "$ref": "#/definitions/Transaction"
                        }
                    },
                    "400": {
                        "description": "Invalid params",
                        "schema": {
                            "$ref": "#/definitions/InvalidParamsErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Transaction not found",
                        "schema": {
                            "$ref": "#/definitions/TransactionNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            },
            "delete": {
                "summary": "Delete a transaction by ID",
                "tags": ["Transaction"],
                "parameters": [
                    {
                        "name": "transactionId",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "ID of the transaction to delete"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transaction deleted successfully"
                    },
                    "404": {
                        "description": "Transaction not found",
                        "schema": {
                            "$ref": "#/definitions/TransactionNotFoundErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        }
    },
    "definitions": {
        "User": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "first_name": {
                    "type": "string",
                    "example": "John"
                },
                "last_name": {
                    "type": "string",
                    "example": "Doe"
                },
                "email": {
                    "type": "string",
                    "example": "email@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "password123"
                }
            }
        },
        "UserWithTokens": {
            "allOf": [
                {
                    "$ref": "#/definitions/User"
                },
                {
                    "type": "object",
                    "properties": {
                        "tokens": {
                            "accessToken": {
                                "type": "string",
                                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                            },
                            "refreshToken": {
                                "type": "string",
                                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                            }
                        }
                    }
                }
            ]
        },
         "Tokens": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000..."
                },
                "refreshToken": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000..."
                }
            }
        },
        
        "CreateUserParams": {
            "type": "object",
            "properties": {
                "first_name": {
                    "type": "string",
                    "example": "John",
                    "required": true
                },
                "last_name": {
                    "type": "string",
                    "example": "Doe",
                    "required": true
                },
                "email": {
                    "type": "string",
                    "example": "email@example.com",
                    "required": true
                },
                "password": {
                    "type": "string",
                    "example": "password123",
                    "required": true
                }
            }
        },
        "LoginUserParams": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "email@example.com",
                    "required": true
                },
                "password": {
                    "type": "string",
                    "example": "password123",
                    "required": true
                }
            }
        },
         "RefreshTokensParams": {
            "type": "object",
            "properties": {
                "refreshToken": {
                    "type": "string",
                    
                    "required": true
                }
                
            }
        },
        "UserNotFoundErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "User not found"
                }
            }
        },
        "UserBalanceResponse": {
            "type": "object",
            "properties": {
                "earnings": {
                    "type": "string",
                    "example": 5000
                },
                "expenses": {
                    "type": "string",
                    "example": 500
                },
                "investments": {
                    "type": "string",
                    "example": 500
                },
                "balance": {
                    "type": "string",
                    "example": 4000
                }
            }
        },
        "Transaction": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "user_id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "name": {
                    "type": "string",
                    "example": "Salary for June"
                },
                "date": {
                    "type": "string",
                    "example": "2023-06-30T12:00:00Z"
                },
                "type": {
                    "type": "string",
                    "example": "EARNING",
                    "description": "Type of transaction. Can be EARNING, EXPENSE, or INVESTMENT"
                },
                "amount": {
                    "type": "number",
                    "example": 100.0
                }
            }
        },
        "CreateTransactionParams": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string",
                    "example": "2023-06-30T12:00:00Z",
                    "required": true
                },
                "name": {
                    "type": "string",
                    "example": "Salary for June",
                    "required": true
                },
                "type": {
                    "type": "string",
                    "example": "EARNING",
                    "description": "Type of transaction. Can be EARNING, EXPENSE, or INVESTMENT",
                    "required": true
                },
                "amount": {
                    "type": "number",
                    "example": 100.0,
                    "required": true
                }
            }
        },
        "UpdateTransactionParams": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string",
                    "example": "2023-06-30T12:00:00Z"
                },
                "name": {
                    "type": "string",
                    "example": "Salary for June"
                },
                "type": {
                    "type": "string",
                    "example": "EARNING",
                    "description": "Type of transaction. Can be EARNING, EXPENSE, or INVESTMENT"
                },
                "amount": {
                    "type": "number",
                    "example": 100.0
                }
            }
        },
        "TransactionNotFoundErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Transaction not found"
                }
            }
        },
        "InternalServerErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Internal server error"
                }
            }
        },
        "InvalidParamsErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Invalid params"
                }
            }
        },
        "UnauthorizedErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "unauthorized"
                }
            }
        }
    }
}
